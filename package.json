{
  "name": "@developerz-ai/designer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: chat with an agent, redesign the live page in real time, ship the real code via MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ai-designer.git"
  },
  "homepage": "https://github.com/developerz-ai/ai-designer#readme",
  "bugs": {
    "url": "https://github.com/developerz-ai/ai-designer/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "wxt",
    "local": "bash scripts/build-local.sh",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run crx:key && wxt build && bun run crx",
    "build:firefox": "wxt build -b firefox",
    "crx": "bash scripts/pack-crx.sh",
    "crx:key": "bun scripts/crx-key.ts --ensure",
    "crx:id": "bun scripts/crx-key.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:store": "CWS_UPLOAD=1 wxt build && CWS_UPLOAD=1 wxt zip",
    "release": "bun run build && wxt zip",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:watch": "vitest",
    "test:changed": "vitest related --run $(git diff --name-only $(git merge-base HEAD origin/main) -- 'src/**/*.ts' 'src/**/*.tsx' | tr '\\n' ' ')",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "debug:live": "bun scripts/debug-live.ts",
    "verify": "bash scripts/verify.sh",
    "check": "bash scripts/verify.sh --check",
    "gate": "bash scripts/verify.sh --gate",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.10",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@sentry/browser": "^10.62.0",
    "@wxt-dev/i18n": "^0.2.6",
    "ai": "^7.0.19",
    "solid-js": "^1.9.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.43",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@wxt-dev/module-solid": "^1.1.0",
    "crx3": "^2.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sass": "^1.83.0",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.9",
    "wxt": "^0.20.0"
  }
}
