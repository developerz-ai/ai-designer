{
  "mcpServers": {
    "glitchtip": {
      "type": "http",
      "url": "https://glitchtip.infra.developerz.ai/mcp"
    },
    "kubeez": {
      "type": "http",
      "url": "https://mcp.kubeez.com/mcp"
    },
    "ui-debugger": {
      "command": "npx",
      "args": ["-y", "@developerz.ai/ui-debugger-mcp@latest"],
      "env": {
        "OPENAI_API_KEY": "${UI_DEBUGGER_API_KEY}",
        "OPENAI_BASE_URL": "${UI_DEBUGGER_BASE_URL:-https://openrouter.ai/api/v1}"
      }
    },
    "sentry-mcp": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@sentry/mcp-server"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}",
        "SENTRY_HOST": "${SENTRY_HOST}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": {
        "DO_NOT_TRACK": "1",
        "CODEGRAPH_TELEMETRY": "0",
        "CODEGRAPH_NO_UPDATE_CHECK": "1"
      }
    },
    "developerz": {
      "type": "http",
      "url": "https://mcp.developerz.ai/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVELOPERZ_API_KEY}"
      }
    }
  }
}
