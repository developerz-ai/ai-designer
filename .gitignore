node_modules
.wxt
stats.html
coverage
*.tsbuildinfo

# extension build output (wxt.config.ts `outDir`) — keep the dir, drop the artifacts
build/*
!build/.keep

# CRX signing keys — the private key IS the extension ID. Never commit one.
keys/*
!keys/.keep

# landing site (site/) build output
site/dist

# local secrets / env — .env holds a real BYOK provider key for `bun run debug:live`
# (see .env.example). Never commit one; the extension itself never reads these.
*.local
.env
.env.*
!.env.example

# test artifacts
test-results
playwright-report
.playwright

# os
.DS_Store
Thumbs.db

# claudetm / build-tool working dirs — never commit
.claude-task-master/
claudetm.log
goal.txt

# CodeGraph index — local per-machine SQLite graph, never commit
.codegraph/

# ui-debugger-mcp workspace (sessions, chrome profile, logs)
tmp/

# editor settings — per-machine (extensions.json stays shared)
.vscode/settings.json

# Live-debug + QA screenshots — local artefacts, never committed.
.debug-shots/
