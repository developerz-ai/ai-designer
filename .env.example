# Local-only settings for `bun run debug:live` — the scripted driver that loads the built
# extension in a real Chromium, configures the provider through the actual Settings UI, and runs a
# turn against a real page so a bug can be reproduced instead of guessed at.
#
# Copy to `.env` and fill in. `.env` is gitignored; nothing here is read by the extension itself
# (BYOK keys live encrypted in chrome.storage.local — see docs/architecture/security.md).

# BYOK provider key used ONLY by the debug driver. An OpenRouter key here; any
# openai-compatible key works if you also change DZ_DEBUG_BASE_URL.
DZ_DEBUG_API_KEY=sk-or-v1-...

# Provider endpoint the driver saves. Default: OpenRouter.
DZ_DEBUG_BASE_URL=https://openrouter.ai/api/v1

# Model the driver saves. Keep this CHEAP — a debug run is not worth frontier pricing, and the
# driver runs real turns. It must still do tools + vision, or the design loop can't work at all.
# qwen3.7-flash: ~$0.03/M in, vision + tool calling.
DZ_DEBUG_MODEL=qwen/qwen3.7-flash

# Page the driver designs against.
DZ_DEBUG_URL=https://example.com

# Set to 1 to watch the browser instead of running headless.
DZ_DEBUG_HEADED=0

# `bun run debug:live` flags (all also available on the CLI):
#   --say "<instruction>"   what to ask the agent to do
#   --url <page>            page to design against
#   --model <id>            override DZ_DEBUG_MODEL for one run
#   --overlay               turn the on-page agent overlay on first
#   --repeat <n>            run the same instruction n times in one session
#   --no-turn               provider setup + readiness only (spends nothing)
#   --headed                watch the browser
